# Set secrets through Vercel environment settings, never commit their values.
GBRAIN_PUBLIC_URL=https://brain.example.com
GBRAIN_DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/brain?sslmode=require
GBRAIN_WORKER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/brain?sslmode=require
GBRAIN_POOL_SIZE=2
GBRAIN_PREPARE=false
GBRAIN_SANDBOX_DRIVE=brain-production
GBRAIN_SANDBOX_IMAGE=registry.example.com/brain@sha256:REPLACE_WITH_IMAGE_DIGEST
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
GBRAIN_EMBEDDING_MODEL=openai:text-embedding-3-small
GBRAIN_EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=
GBRAIN_GIT_TOKEN=
